{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding-schema-v1.json",
  "title": "Linux Security Checker Finding Schema",
  "description": "Structured security assessment data contract.",
  "type": "object",
  "required": [
    "schema_version",
    "assessment",
    "asset",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "assessment": {
      "type": "object",
      "required": [
        "assessment_id",
        "scanner",
        "score",
        "risk_level"
      ],
      "properties": {
        "assessment_id": {
          "type": "string"
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "scanner": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "remediation_policy": {
          "type": "object",
          "required": [
            "environment",
            "summary"
          ],
          "properties": {
            "environment": {
              "type": "string",
              "enum": [
                "lab",
                "development",
                "test",
                "staging",
                "production",
                "unknown"
              ]
            },
            "summary": {
              "type": "object",
              "required": [
                "apply",
                "dry_run",
                "blocked"
              ],
              "properties": {
                "apply": {
                  "type": "integer",
                  "minimum": 0
                },
                "dry_run": {
                  "type": "integer",
                  "minimum": 0
                },
                "blocked": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "execution_plan": {
          "type": "object",
          "required": [
            "environment",
            "summary",
            "items"
          ],
          "properties": {
            "environment": {
              "type": "string",
              "enum": [
                "lab",
                "development",
                "test",
                "staging",
                "production",
                "unknown"
              ]
            },
            "summary": {
              "type": "object",
              "required": [
                "apply",
                "dry_run",
                "blocked"
              ],
              "properties": {
                "apply": {
                  "type": "integer",
                  "minimum": 0
                },
                "dry_run": {
                  "type": "integer",
                  "minimum": 0
                },
                "blocked": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "finding_id",
                  "policy_decision",
                  "execution_decision",
                  "action",
                  "reason"
                ],
                "properties": {
                  "finding_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "policy_decision": {
                    "type": "string",
                    "enum": [
                      "apply",
                      "dry-run",
                      "blocked"
                    ]
                  },
                  "execution_decision": {
                    "type": "string",
                    "enum": [
                      "apply",
                      "dry-run",
                      "blocked"
                    ]
                  },
                  "action": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "execution": {
          "type": "object",
          "required": [
            "environment",
            "summary",
            "results",
            "audit_trail"
          ],
          "properties": {
            "environment": {
              "type": "string",
              "enum": [
                "lab",
                "development",
                "test",
                "staging",
                "production",
                "unknown"
              ]
            },
            "summary": {
              "type": "object",
              "required": [
                "executed",
                "dry_run",
                "blocked",
                "failed"
              ],
              "properties": {
                "executed": {
                  "type": "integer",
                  "minimum": 0
                },
                "dry_run": {
                  "type": "integer",
                  "minimum": 0
                },
                "blocked": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "finding_id",
                  "decision",
                  "action",
                  "status",
                  "reason"
                ],
                "properties": {
                  "finding_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "decision": {
                    "type": "string",
                    "enum": [
                      "apply",
                      "dry-run",
                      "blocked"
                    ]
                  },
                  "action": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "executed",
                      "dry-run",
                      "blocked",
                      "failed"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "audit_trail": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "timestamp",
                  "actor",
                  "finding_id",
                  "decision",
                  "action",
                  "status",
                  "reason"
                ],
                "properties": {
                  "timestamp": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "actor": {
                    "type": "string"
                  },
                  "finding_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "decision": {
                    "type": "string",
                    "enum": [
                      "apply",
                      "dry-run",
                      "blocked"
                    ]
                  },
                  "action": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "executed",
                      "dry-run",
                      "blocked",
                      "failed"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "execution_evidence": {
          "type": "object",
          "required": [
            "manifest_version",
            "run_id",
            "created_at",
            "actor",
            "environment",
            "summary",
            "evidence",
            "integrity"
          ],
          "properties": {
            "manifest_version": {
              "type": "string"
            },
            "run_id": {
              "type": "string"
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "actor": {
              "type": "string"
            },
            "environment": {
              "type": "string",
              "enum": [
                "lab",
                "development",
                "test",
                "staging",
                "production",
                "unknown"
              ]
            },
            "summary": {
              "type": "object",
              "required": [
                "executed",
                "dry_run",
                "blocked",
                "failed"
              ],
              "properties": {
                "executed": {
                  "type": "integer",
                  "minimum": 0
                },
                "dry_run": {
                  "type": "integer",
                  "minimum": 0
                },
                "blocked": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "finding_id",
                  "decision",
                  "action",
                  "execution_status",
                  "reason",
                  "final_finding_status",
                  "remediation_applied",
                  "verification_passed",
                  "verification_failed",
                  "rollback_performed",
                  "rollback_verified",
                  "finding_audit_events"
                ],
                "properties": {
                  "finding_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "decision": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "action": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "execution_status": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "final_finding_status": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "remediation_applied": {
                    "type": "boolean"
                  },
                  "verification_passed": {
                    "type": "boolean"
                  },
                  "verification_failed": {
                    "type": "boolean"
                  },
                  "rollback_performed": {
                    "type": "boolean"
                  },
                  "rollback_verified": {
                    "type": "boolean"
                  },
                  "finding_audit_events": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "integrity": {
              "type": "object",
              "required": [
                "algorithm",
                "sha256"
              ],
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "sha256"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            },
            "provenance": {
              "type": "object",
              "required": [
                "algorithm",
                "key_fingerprint",
                "signature"
              ],
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "ed25519"
                  ]
                },
                "key_fingerprint": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "signature": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "asset_id",
        "hostname",
        "asset_type",
        "environment"
      ],
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "asset_type": {
          "type": "string"
        },
        "operating_system": {
          "type": [
            "string",
            "null"
          ]
        },
        "kernel_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "type": "string",
          "enum": [
            "lab",
            "development",
            "test",
            "staging",
            "production",
            "unknown"
          ]
        },
        "internet_exposed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "business_criticality": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            "unknown",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "finding_id",
        "category",
        "title",
        "baseline_severity",
        "status",
        "source",
        "evidence",
        "classification",
        "remediation",
        "verification"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "baseline_severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "under_review",
            "approved",
            "remediated",
            "verified",
            "accepted",
            "false_positive"
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "type",
            "module"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "module": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "oneOf": [
            {
              "title": "Configuration Evidence",
              "type": "object",
              "required": [
                "type",
                "source",
                "key",
                "observed_value"
              ],
              "properties": {
                "type": {
                  "const": "configuration"
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "observed_value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "title": "Command Output Evidence",
              "type": "object",
              "required": [
                "type",
                "source",
                "key",
                "observed_value"
              ],
              "properties": {
                "type": {
                  "const": "command_output"
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "observed_value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "title": "Socket Evidence",
              "type": "object",
              "required": [
                "type",
                "source",
                "protocol",
                "bind_address",
                "port",
                "internet_exposed"
              ],
              "properties": {
                "type": {
                  "const": "socket"
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "protocol": {
                  "type": "string",
                  "enum": [
                    "tcp",
                    "udp"
                  ]
                },
                "bind_address": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "process": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "internet_exposed": {
                  "enum": [
                    true,
                    false,
                    "unknown"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "title": "Package Inventory Evidence",
              "type": "object",
              "required": [
                "type",
                "source",
                "package_manager",
                "update_count",
                "security_updates_confirmed"
              ],
              "properties": {
                "type": {
                  "const": "package_inventory"
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "package_manager": {
                  "type": "string",
                  "minLength": 1
                },
                "update_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "security_updates_confirmed": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "classification": {
          "type": "object",
          "required": [
            "cve",
            "cwe",
            "cvss"
          ],
          "properties": {
            "cve": {
              "type": [
                "string",
                "null"
              ]
            },
            "cwe": {
              "type": [
                "string",
                "null"
              ]
            },
            "cvss": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "remediation": {
          "type": "object",
          "required": [
            "recommendation",
            "approval_status",
            "applied"
          ],
          "properties": {
            "recommendation": {
              "type": "string"
            },
            "approval_status": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "rejected",
                "modified"
              ]
            },
            "applied": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "verification": {
          "type": "object",
          "required": [
            "security",
            "configuration",
            "functionality"
          ],
          "properties": {
            "security": {
              "type": "string",
              "enum": [
                "not_tested",
                "pass",
                "fail"
              ]
            },
            "configuration": {
              "type": "string",
              "enum": [
                "not_tested",
                "pass",
                "fail"
              ]
            },
            "functionality": {
              "type": "string",
              "enum": [
                "not_tested",
                "pass",
                "fail"
              ]
            }
          },
          "additionalProperties": false
        },
        "priority": {
          "type": "object",
          "required": [
            "score",
            "reasons",
            "engine"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "reasons": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "engine": {
              "type": "object",
              "required": [
                "name",
                "version"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "human_review": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "reviewer",
            "decision",
            "reviewed_at",
            "note"
          ],
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "type": "string",
              "enum": [
                "approved",
                "rejected",
                "modified",
                "accepted_risk",
                "false_positive"
              ]
            },
            "reviewed_at": {
              "type": "string",
              "format": "date-time"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "audit_trail": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "timestamp",
              "actor",
              "action",
              "from_status",
              "to_status"
            ],
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "actor": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "enum": [
                  "review_started",
                  "approved",
                  "rejected",
                  "modified",
                  "remediation_applied",
                  "verification_passed",
                  "verification_failed",
                  "risk_accepted",
                  "marked_false_positive"
                ]
              },
              "from_status": {
                "type": "string",
                "enum": [
                  "open",
                  "under_review",
                  "approved",
                  "remediated",
                  "verified",
                  "accepted",
                  "false_positive"
                ]
              },
              "to_status": {
                "type": "string",
                "enum": [
                  "open",
                  "under_review",
                  "approved",
                  "remediated",
                  "verified",
                  "accepted",
                  "false_positive"
                ]
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
