{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-analysis-report-schema-v1.json",
  "title": "AI-Assisted Security Finding Analysis Report",
  "type": "object",
  "required": [
    "schema_version",
    "assessment_id",
    "source_assessment_sha256",
    "advisory_only",
    "analyses"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "source_assessment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "advisory_only": {
      "const": true
    },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "provider",
          "risk_summary",
          "evidence_interpretation",
          "recommended_action",
          "confidence",
          "confidence_basis",
          "priority_recommendation",
          "evidence_refs",
          "limitations",
          "requires_human_review",
          "execution_authorized",
          "input_sha256"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "object",
            "required": ["name", "model"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "risk_summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_interpretation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommended_action": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence_basis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "priority_recommendation": {
            "enum": [
              "increase",
              "keep",
              "decrease"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requires_human_review": {
            "const": true
          },
          "execution_authorized": {
            "const": false
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
